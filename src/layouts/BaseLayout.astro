---
interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonicalPath?: string;
  robots?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  keywords = "豊川和太鼓,威鳴太鼓,いなり太鼓,豊川高校和太鼓部,愛知県和太鼓,和太鼓部活動,和太鼓ニュース",
  ogImage = "/images/hero.PNG",
  ogImageAlt = "威鳴太鼓（豊川高校和太鼓部）の活動写真",
  canonicalPath,
  robots,
  ogType = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  author = "威鳴太鼓（豊川高校和太鼓部）",
  structuredData
} = Astro.props as Props;

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.url.origin).toString();
const absoluteOgImage = new URL(ogImage, Astro.url.origin).toString();
const siteUrl = new URL("/", Astro.url.origin).toString();
const siteName = "豊川高校和太鼓部公式サイト│「威鳴太鼓」";
const robotsContent =
  noindex
    ? "noindex, nofollow"
    : robots ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const extraStructuredDataList = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const structuredDataList = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonicalUrl,
    inLanguage: "ja-JP",
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: siteUrl
    }
  },
  ...extraStructuredDataList
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="googlebot" content={robotsContent} />
    <meta name="format-detection" content="telephone=no, address=no, email=no" />
    <meta name="robots" content={robotsContent} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {modifiedTime ? <meta property="article:modified_time" content={modifiedTime} /> : null}
    {modifiedTime ? <meta property="og:updated_time" content={modifiedTime} /> : null}
    {ogType === "article" ? <meta property="article:author" content={author} /> : null}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ja-JP" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={new URL("/sitemap.xml", Astro.url.origin).toString()} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={new URL("/rss.xml", Astro.url.origin).toString()} />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <link rel="apple-touch-icon" href="/images/logo.jpg" />
    <link rel="shortcut icon" href="/images/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Noto+Serif+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
    {
      structuredDataList.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      ))
    }
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-ink)]">
    <div id="opening-curtain" class="fixed inset-0 z-[100] bg-black"></div>
    <div id="site-root">
      <slot />
      <footer class="px-4 py-6 text-center text-xs tracking-[0.08em] text-[rgba(16,16,16,0.72)]">
        <nav class="mb-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm">
          <a href="/about" class="underline decoration-[rgba(16,16,16,0.45)] underline-offset-4 hover:text-[rgba(16,16,16,0.9)]">
            このサイトについて
          </a>
          <a
            href="https://inari-hue.frontolia.com"
            class="underline decoration-[rgba(16,16,16,0.45)] underline-offset-4 hover:text-[rgba(16,16,16,0.9)]"
          >
            笛運指表一覧サイト
          </a>
          <a
            href="https://shinobue.frontolia.com"
            class="underline decoration-[rgba(16,16,16,0.45)] underline-offset-4 hover:text-[rgba(16,16,16,0.9)]"
          >
            篠笛運指表作成アプリ
          </a>
        </nav>
        <p class="mb-2">当サイトで使用している画像等は著作権の関係上、無断で使用することを禁じます。</p>
        ©2026 FRONTOLIA インターネット 豊川高校和太鼓部 All Rights Reserved
      </footer>
    </div>
  </body>
</html>
