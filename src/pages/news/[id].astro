---
import "../../styles/global.css";
import { fetchNewsById, formatDate, getCategoryLabel, stripHtml, toSummary } from "../../lib/news";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/sections/Header.astro";

export const prerender = false;

const id = Astro.params.id ?? "";
const item = await fetchNewsById(id);

if (!item) {
  Astro.response.status = 404;
}
const title = item?.title ?? "ニュース詳細";
const htmlContent = item?.content ?? "";
const plainContent = stripHtml(htmlContent);
const categoryLabel = getCategoryLabel(item?.category);
const dateLabel = formatDate(item?.time ?? "");
const articlePath = `/news/${encodeURIComponent(id)}`;
const articleUrl = new URL(articlePath, Astro.url.origin).toString();
const fallbackDescription = "威鳴太鼓（豊川高校和太鼓部）のニュース詳細ページです。";
const articleSummary = toSummary(htmlContent, 140) || fallbackDescription;
const keywords = [categoryLabel, "威鳴太鼓", "いなり太鼓", "豊川和太鼓", "豊川高校和太鼓部"].join(",");
const structuredData = item
  ? [
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "ホーム",
            item: new URL("/", Astro.url.origin).toString()
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "ニュース一覧",
            item: new URL("/news", Astro.url.origin).toString()
          },
          {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: articleUrl
          }
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        headline: title,
        description: articleSummary,
        inLanguage: "ja-JP",
        datePublished: item.time,
        dateModified: item.time,
        articleSection: categoryLabel,
        url: articleUrl,
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": articleUrl
        },
        articleBody: plainContent,
        wordCount: plainContent.length,
        isAccessibleForFree: true,
        author: {
          "@type": "Organization",
          name: "威鳴太鼓"
        },
        publisher: {
          "@type": "Organization",
          name: "威鳴太鼓",
          logo: {
            "@type": "ImageObject",
            url: new URL("/images/logo.jpg", Astro.url.origin).toString()
          }
        },
        image: [new URL("/images/hero.PNG", Astro.url.origin).toString()]
      }
    ]
  : undefined;
---

<BaseLayout
  title={`${title} | 豊川高校和太鼓部公式サイト│「威鳴太鼓」`}
  description={item ? articleSummary : "指定されたニュースは見つかりませんでした。"}
  keywords={keywords}
  canonicalPath={articlePath}
  ogType="article"
  publishedTime={item?.time}
  modifiedTime={item?.time}
  noindex={!item}
  structuredData={structuredData}
>
  <Header />
  <main class="news-page-main">
    <article class="section-inner news-detail-article">
      <div class="news-page-head">
        <p class="section-label">NEWS DETAIL</p>
        <h1 class="section-title">{title}</h1>
        {
          item && (
            <div class="news-meta">
              <span class="category-pill">{categoryLabel}</span>
              <time datetime={item.time}>{dateLabel}</time>
            </div>
          )
        }
      </div>

      {
        item ? (
          <div class="news-detail-body panel-lacquer prose-ja" set:html={htmlContent}></div>
        ) : (
          <div class="news-detail-body panel-lacquer prose-ja">
            <p>指定されたニュースは見つかりませんでした。</p>
          </div>
        )
      }

      <div class="news-detail-actions">
        <a href="/news" class="primary-button">全てのニュースを見る</a>
        <a href="/" class="primary-button">トップページへ戻る</a>
      </div>
    </article>
  </main>
</BaseLayout>
