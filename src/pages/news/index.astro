---
import "../../styles/global.css";
import { fetchNews, formatDate, getCategoryLabel, toSummary } from "../../lib/news";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/sections/Header.astro";

const newsResult = await fetchNews();
const newsItems = newsResult.items.map((item) => ({
  id: item.id,
  title: item.title,
  summary: toSummary(item.content, 20),
  category: getCategoryLabel(item.category),
  date: formatDate(item.time),
  datetime: item.time
}));

const listUrl = new URL("/news", Astro.url.origin).toString();
const homeUrl = new URL("/", Astro.url.origin).toString();
const listDescription =
  "豊川和太鼓 威鳴太鼓（いなり太鼓）のニュース一覧ページです。大会結果・公演情報・活動レポートを最新順で掲載しています。";
const latestDateTime = newsItems[0]?.datetime;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "ホーム",
        item: new URL("/", Astro.url.origin).toString()
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "ニュース一覧",
        item: listUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "ニュース一覧 | 豊川高校和太鼓部公式サイト│「威鳴太鼓」",
    description: listDescription,
    url: listUrl,
    inLanguage: "ja-JP",
    isPartOf: {
      "@type": "WebSite",
      name: "豊川高校和太鼓部公式サイト│「威鳴太鼓」",
      url: homeUrl
    },
    ...(latestDateTime ? { dateModified: latestDateTime } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "威鳴太鼓ニュース一覧",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: newsItems.length,
    itemListElement: newsItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/news/${item.id}`, Astro.url.origin).toString(),
      name: item.title
    }))
  }
];
---

<BaseLayout
  title="ニュース一覧 | 豊川高校和太鼓部公式サイト│「威鳴太鼓」"
  description={listDescription}
  keywords="豊川和太鼓,いなり太鼓,威鳴太鼓,ニュース一覧,和太鼓活動情報,公演情報,部活動ニュース"
  canonicalPath="/news"
  modifiedTime={latestDateTime}
  structuredData={structuredData}
>
  <Header />
  <main class="news-page-main">
    <div class="section-inner">
      <div class="news-page-head">
        <p class="section-label">NEWS</p>
        <h1 class="section-title">全てのニュース</h1>
        <a href="/" class="primary-button">トップページへ戻る</a>
      </div>

      {
        newsItems.length > 0 ? (
          <div class="news-page-list">
            {newsItems.map((item) => (
              <a href={`/news/${item.id}`} class="news-list-item news-card-link">
                <article class="news-card news-card-pro">
                  <div class="news-meta">
                    <span class="category-pill">{item.category}</span>
                    <time datetime={item.datetime}>{item.date}</time>
                  </div>
                  <h2 class="font-title text-xl leading-snug text-white">{item.title}</h2>
                  <p class="news-summary-one-line mt-3 text-sm leading-relaxed text-white/80 sm:text-base">{item.summary}</p>
                </article>
              </a>
            ))}
          </div>
        ) : (
          <div class="news-card news-card-pro news-empty">
            <p>{newsResult.message ?? "現在、ニュースは準備中です。"}</p>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
