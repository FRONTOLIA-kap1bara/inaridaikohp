---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { fetchNews } from "../lib/news";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/sections/Header.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import InfoSection from "../components/sections/InfoSection.astro";
import NewsSection from "../components/sections/NewsSection.astro";
import SnsSection from "../components/sections/SnsSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import SiteAnimations from "../components/SiteAnimations.astro";

type ImageEntry = {
  path: string;
  name: string;
  image: ImageMetadata;
};

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/raw/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP}",
  { eager: true }
);

const allImages: ImageEntry[] = Object.entries(imageModules)
  .map(([path, module]) => ({
    path,
    name: path.split("/").pop() ?? "",
    image: module.default
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const heroNames = ["hero.PNG", "hero1.PNG", "hero2.PNG", "hero3.PNG"];
const heroImages = heroNames
  .map((name) =>
    allImages.find((item) => item.name.toLowerCase() === name.toLowerCase())
  )
  .filter((item): item is ImageEntry => Boolean(item));

if (heroImages.length < 4) {
  const fallbackImages = allImages.filter(
    (item) =>
      item.name.toLowerCase() !== "logo.jpg" &&
      !heroImages.some((hero) => hero.name === item.name)
  );
  heroImages.push(...fallbackImages.slice(0, 4 - heroImages.length));
}

const usedImageNames = new Set(
  [...heroImages, ...allImages.filter((img) => img.name.toLowerCase() === "logo.jpg")].map(
    (item) => item.name.toLowerCase()
  )
);

const galleryPool = allImages.filter(
  (item) => !usedImageNames.has(item.name.toLowerCase())
);

const infoImages = galleryPool.slice(0, 2);
const newsImages = galleryPool.slice(2, 4);
const snsImages = galleryPool.slice(4, 6);

const formatDate = (value: string) => {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
  }).format(date);
};

const getCategoryLabel = (category: unknown) => {
  if (!category) return "お知らせ";
  if (typeof category === "string") return category;
  if (typeof category === "object" && "name" in category) {
    const categoryName = category.name;
    return typeof categoryName === "string" && categoryName ? categoryName : "お知らせ";
  }
  return "お知らせ";
};

const toSummary = (text: string) => {
  const stripped = text
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  return stripped.length > 140 ? `${stripped.slice(0, 140)}...` : stripped;
};

const newsResult = await fetchNews();
const newsItems = newsResult.items.map((item) => ({
  id: item.id,
  title: item.title,
  summary: toSummary(item.content),
  category: getCategoryLabel(item.category),
  date: formatDate(item.time),
  datetime: item.time
}));
const newsMessage = newsResult.message ?? "現在、ニュースは準備中です。";
---

<BaseLayout
  title="威鳴太鼓 | 豊川高校和太鼓部"
  description="豊川高校和太鼓部「威鳴太鼓（いなりだいこ）」の公式情報と活動紹介。笑顔と元気で伝統の響きを届ける、和の鼓動を体感できるワンページサイト。"
>
  <Header />
  <main>
    <HeroSection heroImages={heroImages} />
    <InfoSection infoImages={infoImages} />
    <NewsSection newsItems={newsItems} newsMessage={newsMessage} newsImages={newsImages} />
    <SnsSection snsImages={snsImages} />
    <ContactSection />
  </main>
  <SiteAnimations />
</BaseLayout>
