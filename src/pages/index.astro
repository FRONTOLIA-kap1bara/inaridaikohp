---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { fetchNews, formatDate, getCategoryLabel, toSummary } from "../lib/news";
import { fetchGallery } from "../lib/gallery";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/sections/Header.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import InfoSection from "../components/sections/InfoSection.astro";
import NewsSection from "../components/sections/NewsSection.astro";
import SnsSection from "../components/sections/SnsSection.astro";
import GallerySection from "../components/sections/GallerySection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import SiteAnimations from "../components/SiteAnimations.astro";

type ImageEntry = {
  path: string;
  name: string;
  image: ImageMetadata;
};

const rawImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/raw/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP}",
  { eager: true }
);
const customImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../images/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP}",
  { eager: true }
);

const mapImageModules = (modules: Record<string, { default: ImageMetadata }>): ImageEntry[] =>
  Object.entries(modules).map(([path, module]) => ({
    path,
    name: path.split("/").pop() ?? "",
    image: module.default
  }));

const mergedImageMap = new Map<string, ImageEntry>();
for (const entry of mapImageModules(rawImageModules)) {
  mergedImageMap.set(entry.name.toLowerCase(), entry);
}
for (const entry of mapImageModules(customImageModules)) {
  mergedImageMap.set(entry.name.toLowerCase(), entry);
}

const allImages: ImageEntry[] = [...mergedImageMap.values()].sort((a, b) => a.name.localeCompare(b.name));

const getBaseName = (name: string) => name.replace(/\.[^.]+$/, "").toLowerCase();

const findImageByBase = (baseName: string) => {
  const targetBase = baseName.toLowerCase();
  const candidates = allImages.filter((item) => getBaseName(item.name) === targetBase);
  if (candidates.length === 0) return undefined;
  const customCandidate = candidates.find((item) => item.path.includes("/images/"));
  return customCandidate ?? candidates[0];
};

const pickImagesByBases = (baseNames: string[]) =>
  baseNames
    .map((baseName) => findImageByBase(baseName))
    .filter((item): item is ImageEntry => Boolean(item));

const heroImages = pickImagesByBases(["hero", "hero2", "hero3", "hero4", "hero5"]);
const infoImages = pickImagesByBases(["info", "info2", "info3"]);
const newsImages = pickImagesByBases(["news", "news2"]);
const snsImages = pickImagesByBases(["sns", "sns2", "sns3"]);

const usedImageNames = new Set(
  [
    ...heroImages,
    ...infoImages,
    ...newsImages,
    ...snsImages,
    ...allImages.filter((img) => img.name.toLowerCase() === "logo.jpg")
  ].map((item) => item.name.toLowerCase())
);

const fallbackImages = allImages.filter(
  (item) => !usedImageNames.has(item.name.toLowerCase())
);

const fillMissingImages = (target: ImageEntry[], expected: number) => {
  if (target.length >= expected) return target;
  const available = fallbackImages.filter(
    (item) => !target.some((picked) => picked.name.toLowerCase() === item.name.toLowerCase())
  );
  target.push(...available.slice(0, expected - target.length));
  return target;
};

fillMissingImages(heroImages, 5);
fillMissingImages(infoImages, 3);
fillMissingImages(newsImages, 2);
fillMissingImages(snsImages, 3);

const newsResult = await fetchNews();
const topNewsItems = newsResult.items.slice(0, 5).map((item) => ({
  id: item.id,
  title: item.title,
  summary: toSummary(item.content),
  category: getCategoryLabel(item.category),
  date: formatDate(item.time),
  datetime: item.time
}));

const newsMessage = newsResult.message ?? "現在、ニュースは準備中です。";
const galleryResult = await fetchGallery(8);
const galleryItems = galleryResult.items;
const galleryMessage = galleryResult.message ?? "現在、ギャラリーは準備中です。";

const homeUrl = new URL("/", Astro.url.origin).toString();
const logoUrl = new URL("/images/logo.jpg", Astro.url.origin).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "豊川高校和太鼓部公式サイト│「威鳴太鼓」",
    url: homeUrl,
    inLanguage: "ja-JP",
    publisher: {
      "@type": "Organization",
      name: "威鳴太鼓"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "威鳴太鼓",
    alternateName: "豊川高校和太鼓部",
    url: homeUrl,
    logo: logoUrl,
    sameAs: [
      "https://www.instagram.com/toyokawa_wadaiko",
      "https://toyokawa.ed.jp/club/japanesedrum"
    ]
  }
];
---

<BaseLayout
  title="豊川高校和太鼓部公式サイト│「威鳴太鼓」"
  description="豊川高校和太鼓部「威鳴太鼓」の公式サイトです。最新のニュースからSNS、演奏依頼も受け付けています。"
  keywords="豊川和太鼓,いなり太鼓,威鳴太鼓,豊川高校和太鼓部,愛知県和太鼓,和太鼓活動,和太鼓ニュース,和太鼓公演"
  canonicalPath="/"
  structuredData={structuredData}
>
  <Header />
  <main>
    <HeroSection heroImages={heroImages} />
    <InfoSection infoImages={infoImages} />
    <NewsSection
      newsItems={topNewsItems}
      newsMessage={newsMessage}
      newsImages={newsImages}
    />
    <SnsSection snsImages={snsImages} />
    <GallerySection galleryItems={galleryItems} galleryMessage={galleryMessage} />
    <ContactSection />
  </main>
  <SiteAnimations />
</BaseLayout>
