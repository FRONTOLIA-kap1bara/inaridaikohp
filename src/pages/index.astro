---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { fetchNews, formatDate, getCategoryLabel, toSummary } from "../lib/news";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/sections/Header.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import InfoSection from "../components/sections/InfoSection.astro";
import NewsSection from "../components/sections/NewsSection.astro";
import SnsSection from "../components/sections/SnsSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import SiteAnimations from "../components/SiteAnimations.astro";

type ImageEntry = {
  path: string;
  name: string;
  image: ImageMetadata;
};

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/raw/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP}",
  { eager: true }
);

const allImages: ImageEntry[] = Object.entries(imageModules)
  .map(([path, module]) => ({
    path,
    name: path.split("/").pop() ?? "",
    image: module.default
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const getBaseName = (name: string) => name.replace(/\.[^.]+$/, "").toLowerCase();

const findImageByBase = (baseName: string) =>
  allImages.find((item) => getBaseName(item.name) === baseName.toLowerCase());

const pickImagesByBases = (baseNames: string[]) =>
  baseNames
    .map((baseName) => findImageByBase(baseName))
    .filter((item): item is ImageEntry => Boolean(item));

const heroImages = pickImagesByBases(["hero", "hero1", "hero2", "hero3"]);
const infoImages = pickImagesByBases(["info", "info2"]);
const newsImages = pickImagesByBases(["news", "news2"]);
const snsImages = pickImagesByBases(["sns", "sns2"]);

const usedImageNames = new Set(
  [
    ...heroImages,
    ...infoImages,
    ...newsImages,
    ...snsImages,
    ...allImages.filter((img) => img.name.toLowerCase() === "logo.jpg")
  ].map((item) => item.name.toLowerCase())
);

const fallbackImages = allImages.filter(
  (item) => !usedImageNames.has(item.name.toLowerCase())
);

const fillMissingImages = (target: ImageEntry[], expected: number) => {
  if (target.length >= expected) return target;
  const available = fallbackImages.filter(
    (item) => !target.some((picked) => picked.name.toLowerCase() === item.name.toLowerCase())
  );
  target.push(...available.slice(0, expected - target.length));
  return target;
};

fillMissingImages(heroImages, 4);
fillMissingImages(infoImages, 2);
fillMissingImages(newsImages, 2);
fillMissingImages(snsImages, 2);

const newsResult = await fetchNews();
const topNewsItems = newsResult.items.slice(0, 5).map((item) => ({
  id: item.id,
  title: item.title,
  summary: toSummary(item.content, 20),
  category: getCategoryLabel(item.category),
  date: formatDate(item.time),
  datetime: item.time
}));

const hasMoreNews = newsResult.items.length > 5;
const newsMessage = newsResult.message ?? "現在、ニュースは準備中です。";
---

<BaseLayout
  title="威鳴太鼓│豊川高校和太鼓部"
  description="愛知県豊川市を拠点に活動する和太鼓チーム『いなり太鼓』の公式サイトです。最新ニュースや活動情報をご覧いただけます。"
>
  <Header />
  <main>
    <HeroSection heroImages={heroImages} />
    <InfoSection infoImages={infoImages} />
    <NewsSection
      newsItems={topNewsItems}
      newsMessage={newsMessage}
      newsImages={newsImages}
      hasMoreNews={hasMoreNews}
    />
    <SnsSection snsImages={snsImages} />
    <ContactSection />
  </main>
  <SiteAnimations />
</BaseLayout>
