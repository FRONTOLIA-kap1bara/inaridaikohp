---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "srcset" | "width" | "height"> & {
  name: string;
  image: ImageMetadata;
};

const { name, image, sizes = "(max-width: 768px) 94vw, 55vw", ...attributes } = Astro.props;
const optimized = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/optimized/*.webp", { eager: true }
);
const base = name.replace(/\.[^.]+$/, "").toLowerCase();
const variants = Object.entries(optimized)
  .filter(([path]) => path.split("/").pop()?.startsWith(`${base}-`))
  .map(([, module]) => module.default)
  .sort((a, b) => a.width - b.width);
const source = variants.at(-1) ?? image;
---

<img
  {...attributes}
  src={source.src}
  srcset={variants.length ? variants.map((variant) => `${variant.src} ${variant.width}w`).join(", ") : undefined}
  sizes={variants.length ? sizes : undefined}
  width={source.width}
  height={source.height}
/>
