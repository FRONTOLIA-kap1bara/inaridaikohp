---
import type { ImageMetadata } from "astro";

type NewsImage = {
  name: string;
  image: ImageMetadata;
};

type ViewNewsItem = {
  id: string;
  title: string;
  summary: string;
  category: string;
  date: string;
  datetime: string;
};

interface Props {
  newsItems: ViewNewsItem[];
  newsMessage: string;
  newsImages: NewsImage[];
}

const { newsItems, newsMessage, newsImages } = Astro.props as Props;
---

<section id="news" class="section-frame section-news">
  <div class="section-inner">
    <div class="section-decor">
      <span class="decor-orb decor-orb-c" data-float="slow"></span>
      <span class="decor-ring decor-ring-b" data-float="fast"></span>
      <span class="decor-pill decor-pill-b" data-float="slow"></span>
      <span class="decor-line"></span>
    </div>

    <div class="section-head section-head-light" data-animate="clip-up">
      <p class="section-label">NEWS</p>
      <h2 class="section-title">最新ニュース</h2>
      <p class="section-intro">
        お知らせを最新順で表示しています。タイトルまたは本文の抜粋をクリックすると詳細ページで全文を確認できます。
      </p>
    </div>

    <div class="news-layout">
      <div class="news-feed" data-stagger="news">
        {
          newsItems.length > 0 ? (
            newsItems.map((item, index) => (
              <a href={`/news/${item.id}`} class="news-card-link" data-animate={index % 2 === 0 ? "slide-right" : "slide-left"}>
                <article class="news-card news-card-pro">
                  <div class="news-meta">
                    <span class="category-pill">{item.category}</span>
                    <time datetime={item.datetime}>{item.date}</time>
                  </div>
                  <h3 class="font-title text-xl leading-snug text-white">{item.title}</h3>
                  <p class="news-summary-one-line mt-3 text-sm leading-relaxed text-white/80 sm:text-base">{item.summary}</p>
                </article>
              </a>
            ))
          ) : (
            <div class="news-empty news-card-pro" data-animate="fade-up">
              <p>{newsMessage}</p>
            </div>
          )
        }

        <div class="news-all-link-wrap" data-animate="fade-up">
          <a class="primary-button" href="/news">すべてのニュース</a>
        </div>
      </div>

      <aside class="news-side" data-animate="slide-left">
        <p class="mb-4 font-title text-xl text-white">SNSでも更新中</p>
        <div class="instagram-frame">
          <iframe
            title="豊川和太鼓 Instagram"
            src="https://www.instagram.com/toyokawa_wadaiko/embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            class="h-[480px] w-full rounded-xl border border-white/15 bg-black/35"
          >
          </iframe>
          <a
            href="https://www.instagram.com/toyokawa_wadaiko"
            class="instagram-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagramを開く
          </a>
        </div>
      </aside>
    </div>

    <div class={`news-photo-ribbon news-photo-ribbon-${Math.min(newsImages.length, 2) || 1}`} data-stagger="gallery">
      {
        newsImages.map((entry, index) => (
          <figure class={`photo-frame news-photo framed-photo ${index === 0 ? "news-photo-wide" : ""}`} data-animate="clip-up">
            <img
              src={entry.image.src}
              alt="豊川和太鼓ニュース関連写真"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>
