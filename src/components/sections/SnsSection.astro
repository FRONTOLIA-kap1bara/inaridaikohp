---
import type { ImageMetadata } from "astro";
import OptimizedImage from "../OptimizedImage.astro";
import InstagramIcon from "../InstagramIcon.astro";
import ExternalLinkIcon from "../ExternalLinkIcon.astro";
import WaBackdrop from "../WaBackdrop.astro";

type SnsImage = {
  name: string;
  image: ImageMetadata;
};

interface Props {
  snsImages: SnsImage[];
}

const { snsImages } = Astro.props as Props;
---

<section id="sns" class="section-frame section-sns">
  <WaBackdrop />
  <div class="section-inner">
    <div class="section-head" data-animate="clip-up">
      <p class="section-label">SNS</p>
      <h2 class="section-title">公式SNS</h2>
      <p class="section-intro">
        演奏の様子や、部活の日常をお届け。動画・写真・出演のお知らせはこちらから！
      </p>
    </div>

    <div class="sns-links">
      <a
        href="https://www.instagram.com/toyokawa_wadaiko"
        target="_blank"
        rel="noopener noreferrer"
        class="sns-card sns-card-ig"
        data-animate="pop-in"
      >
        <span class="social-logo social-logo-instagram"><InstagramIcon /></span>
        <span class="social-link-copy">
          <span class="social-link-label">公式 Instagram</span>
          <span class="social-link-description">演奏動画・写真・出演のお知らせ</span>
          <span class="social-link-action">Instagramを開く <ExternalLinkIcon class="external-link-icon" /></span>
        </span>
        <span class="sr-only">（新しいタブで開きます）</span>
      </a>
      <a
        href="https://toyokawa.ed.jp/club/japanesedrum"
        target="_blank"
        rel="noopener noreferrer"
        class="sns-card sns-card-school"
        data-animate="pop-in"
      >
        <span class="social-logo social-logo-school">
          <img src="/images/toyokawa-school-logo.svg" alt="豊川高等学校の校章" width="58" height="55" loading="lazy" />
        </span>
        <span class="social-link-copy">
          <span class="social-link-label">豊川高校 和太鼓部紹介</span>
          <span class="social-link-description">学校公式サイトの部活動紹介</span>
          <span class="social-link-action">学校公式サイトへ <ExternalLinkIcon class="external-link-icon" /></span>
        </span>
        <span class="sr-only">（新しいタブで開きます）</span>
      </a>
    </div>

    <div class="sns-gallery">
      {
        snsImages.map((entry) => (
          <figure
            class="photo-frame sns-photo framed-photo"
            data-animate="photo-reveal"
          >
            <div class="photo-window"><OptimizedImage
              name={entry.name}
              image={entry.image}
              sizes="(max-width: 768px) 94vw, 33vw"
              alt="威鳴太鼓のSNS掲載写真"
              loading="lazy"
              decoding="async"
            /></div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
