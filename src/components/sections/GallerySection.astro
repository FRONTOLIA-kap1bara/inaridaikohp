---
import type { GalleryItem } from "../../lib/gallery";

interface Props {
  galleryItems: GalleryItem[];
  galleryMessage: string;
}

const { galleryItems, galleryMessage } = Astro.props as Props;
---

<section id="gallery" class="section-frame section-gallery">
  <div class="section-inner">
    <div class="section-decor">
      <span class="decor-orb decor-orb-d" data-float="slow"></span>
      <span class="decor-ring decor-ring-c" data-float="fast"></span>
      <span class="decor-pill decor-pill-c" data-float="slow"></span>
      <span class="decor-grid"></span>
    </div>

    <div class="section-head" data-animate="clip-up">
      <p class="section-label">GALLERY</p>
      <h2 class="section-title">ギャラリー</h2>
      <p class="section-intro">
        演奏や活動の写真を掲載しています。定期的に更新しているのでぜひご覧ください。
      </p>
    </div>

    {
      galleryItems.length > 0 ? (
        <div class="gallery-grid">
          {galleryItems.map((item) => (
            <figure class="gallery-photo" data-animate="fade-quick">
              <button
                type="button"
                class="gallery-zoom-button"
                data-gallery-open
                data-image-src={item.imageUrl}
                data-image-alt={item.imageAlt}
                aria-label="画像を拡大表示"
              >
                <img
                  src={item.imageUrl}
                  alt={item.imageAlt}
                  width={item.imageWidth}
                  height={item.imageHeight}
                  loading="lazy"
                  decoding="async"
                  class="gallery-image"
                />
              </button>
            </figure>
          ))}
        </div>
      ) : (
        <div class="gallery-empty panel-lacquer" data-animate="fade-up">
          <p>{galleryMessage}</p>
        </div>
      )
    }

    <dialog class="gallery-lightbox" data-gallery-lightbox aria-label="画像拡大表示">
      <div class="gallery-lightbox-content">
        <button type="button" class="gallery-lightbox-close" data-gallery-close aria-label="閉じる">×</button>
        <img src="" alt="" class="gallery-lightbox-image" data-gallery-image />
      </div>
    </dialog>
  </div>
</section>

<script>
  const section = document.querySelector("#gallery");
  if (!section) {
    // no-op
  } else {
    const lightbox = section.querySelector("[data-gallery-lightbox]");
    const lightboxImage = section.querySelector("[data-gallery-image]");
    const closeButton = section.querySelector("[data-gallery-close]");
    const openButtons = section.querySelectorAll("[data-gallery-open]");

    const closeLightbox = () => {
      if (lightbox instanceof HTMLDialogElement && lightbox.open) {
        lightbox.close();
      }
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement)) return;
        const src = button.getAttribute("data-image-src") ?? "";
        const alt = button.getAttribute("data-image-alt") ?? "";
        if (!src) return;
        lightboxImage.src = src;
        lightboxImage.alt = alt;
        lightbox.showModal();
      });
    });

    closeButton?.addEventListener("click", closeLightbox);

    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    // no-op: gallery image load handling is intentionally omitted to avoid
    // extra scroll-trigger refresh work on mobile scrolling.
  }
</script>
