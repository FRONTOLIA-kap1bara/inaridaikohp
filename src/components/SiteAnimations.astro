<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const curtain = document.querySelector("#opening-curtain");
  const root = document.querySelector("#site-root");

  const revealFallback = () => {
    if (root instanceof HTMLElement) root.style.opacity = "1";
    if (curtain instanceof HTMLElement) {
      curtain.style.opacity = "0";
      curtain.style.visibility = "hidden";
      curtain.style.pointerEvents = "none";
    }
  };

  const onReady = (callback) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
    } else {
      callback();
    }
  };

  const animateByMode = (element, mode) => {
    const base = { duration: 0.8, ease: "power2.out", autoAlpha: 0 };
    const fromConfig =
      mode === "slide-left"
        ? { ...base, x: 56 }
        : mode === "slide-right"
          ? { ...base, x: -56 }
          : mode === "zoom-in"
            ? { ...base, scale: 0.9 }
            : mode === "rise-blur"
              ? { ...base, y: 30, filter: "blur(8px)" }
              : mode === "clip-up"
                ? { ...base, y: 20, clipPath: "inset(0 0 100% 0)" }
                : mode === "rotate-in"
                  ? { ...base, y: 20, rotation: -3, transformOrigin: "left bottom" }
                  : mode === "text-reveal"
                    ? { ...base, y: 24 }
                    : { ...base, y: 20 };

    gsap.fromTo(
      element,
      fromConfig,
      {
        autoAlpha: 1,
        x: 0,
        y: 0,
        scale: 1,
        rotation: 0,
        letterSpacing: "normal",
        filter: "blur(0px)",
        clipPath: "inset(0 0 0% 0)",
        duration: 0.8,
        ease: "power2.out",
        immediateRender: false,
        scrollTrigger: {
          trigger: element,
          start: "top 90%",
          once: true
        }
      }
    );
  };

  const animateSections = () => {
    document.querySelectorAll("[data-animate]").forEach((element) => {
      const mode = element.getAttribute("data-animate") ?? "fade-up";
      animateByMode(element, mode);
    });

    document.querySelectorAll("[data-stagger]").forEach((group) => {
      const children = Array.from(group.children).filter((child) => !child.hasAttribute("data-animate"));
      if (!children.length) return;

      gsap.fromTo(
        children,
        { autoAlpha: 0, y: 24, scale: 0.98 },
        {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          duration: 0.6,
          ease: "power2.out",
          stagger: 0.08,
          immediateRender: false,
          scrollTrigger: {
            trigger: group,
            start: "top 90%",
            once: true
          }
        }
      );
    });

    document.querySelectorAll(".parallax-image").forEach((image) => {
      gsap.to(image, {
        yPercent: 8,
        scale: 1.05,
        ease: "none",
        scrollTrigger: {
          trigger: image,
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });
    });

    document.querySelectorAll("[data-float]").forEach((shape) => {
      const speed = shape.getAttribute("data-float") === "fast" ? 14 : 22;
      gsap.to(shape, {
        y: -20,
        x: 14,
        rotate: 8,
        repeat: -1,
        yoyo: true,
        duration: speed,
        ease: "sine.inOut"
      });
    });
  };

  const handleNavTap = () => {
    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");
        if (!href || !href.startsWith("#")) return;
        const target = document.querySelector(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  };

  const initAnimations = () => {
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    animateSections();
    ScrollTrigger.refresh();
  };

  const runOpening = () => {
    if (!curtain || !root) {
      initAnimations();
      return;
    }
    root.style.opacity = "1";

    gsap
      .timeline()
      .to(curtain, {
        opacity: 0,
        duration: 1.1,
        ease: "power2.out"
      })
      .to(
        root,
        {
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
          onComplete: () => {
            curtain.remove();
            initAnimations();
          }
        },
        "-=0.45"
      );
  };

  onReady(() => {
    handleNavTap();
    runOpening();
  });

  window.setTimeout(() => {
    if (curtain instanceof HTMLElement && curtain.style.opacity !== "0") {
      revealFallback();
      initAnimations();
    }
  }, 2400);
</script>
