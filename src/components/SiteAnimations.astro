<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({
    ignoreMobileResize: true,
    autoRefreshEvents: "visibilitychange,DOMContentLoaded,resize"
  });

  const startAnimations = () => {
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      const mobile = window.matchMedia("(max-width: 768px)").matches;
      const tablet = window.matchMedia("(max-width: 1024px)").matches;

      document.querySelectorAll<HTMLElement>("[data-animate]").forEach((element) => {
        const mode = element.dataset.animate;
        const inGallery = Boolean(element.closest("#gallery"));
        const photo = mode === "photo-reveal";
        const pop = mode === "pop-in";
        const galleryPhoto = inGallery && mode === "fade-quick";
        const galleryHeading = inGallery && mode === "clip-up";
        const start = inGallery
          ? mobile ? "top 68%" : tablet ? galleryPhoto ? "top 62%" : "top 56%" : galleryPhoto ? "top 90%" : "top 84%"
          : photo ? "top 80%" : "top 82%";

        element.dataset.revealState = "pending";
        gsap.fromTo(element, {
          autoAlpha: 0,
          y: galleryPhoto ? 30 : galleryHeading ? 18 : photo ? 52 : 36,
          scale: photo ? 0.96 : pop ? 0.94 : 1,
          ...(galleryHeading ? { clipPath: "inset(0 0 100% 0)" } : {})
        }, {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          duration: galleryPhoto ? 1.25 : photo ? 1.15 : 0.95,
          ease: pop ? "back.out(1.15)" : "power2.out",
          ...(galleryHeading ? { clipPath: "inset(0 0 0% 0)" } : {}),
          onStart: () => { element.dataset.revealState = "running"; },
          onComplete: () => { element.dataset.revealState = "shown"; },
          onReverseComplete: () => { element.dataset.revealState = "pending"; },
          scrollTrigger: {
            trigger: element,
            start,
            end: "bottom top",
            once: inGallery,
            toggleActions: inGallery ? "play none none none" : "play none none reverse",
            invalidateOnRefresh: true
          }
        });
      });

      document.querySelectorAll<HTMLElement>("[data-stagger] > :not([data-animate])").forEach((element) => {
        gsap.fromTo(element, { autoAlpha: 0, y: 28 }, {
          autoAlpha: 1, y: 0, duration: 0.9, ease: "power2.out",
          scrollTrigger: {
            trigger: element, start: "top 82%", end: "bottom top",
            toggleActions: "play none none reverse"
          }
        });
      });

      document.querySelectorAll("[data-float]").forEach((shape) => {
        gsap.to(shape, {
          y: shape.closest(".wa-backdrop") ? -10 : -14,
          x: 6,
          rotation: 2,
          repeat: -1,
          yoyo: true,
          duration: shape.getAttribute("data-float") === "fast" ? 7 : 12,
          ease: "sine.inOut",
          scrollTrigger: {
            trigger: shape.closest("section"),
            start: "top bottom", end: "bottom top",
            toggleActions: "play pause resume pause"
          }
        });
      });

      return () => {
        document.querySelectorAll<HTMLElement>("[data-reveal-state]").forEach((element) => {
          delete element.dataset.revealState;
        });
      };
    });

    // Refresh positions without restarting animations when fonts and lazy images settle.
    let refreshTimer: ReturnType<typeof setTimeout>;
    const refreshWhenIdle = () => {
      // Recalculating mid-scroll interrupts native smooth navigation to section anchors.
      if (ScrollTrigger.isScrolling()) {
        refreshTimer = setTimeout(refreshWhenIdle, 160);
        return;
      }
      ScrollTrigger.refresh();
    };
    const refresh = () => {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(refreshWhenIdle, 160);
    };
    document.fonts?.ready.then(refresh);
    document.querySelectorAll("img[loading='lazy']").forEach((image) => {
      if (!(image instanceof HTMLImageElement) || image.complete) return;
      if (image.hasAttribute("width") && image.hasAttribute("height")) return;
      image.addEventListener("load", refresh, { once: true });
    });
    window.addEventListener("load", refresh, { once: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startAnimations, { once: true });
  } else {
    startAnimations();
  }
</script>
