<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  document.documentElement.classList.add("js-gsap");

  const curtain = document.querySelector("#opening-curtain");
  const root = document.querySelector("#site-root");

  const revealFallback = () => {
    if (root instanceof HTMLElement) root.style.opacity = "1";
    if (curtain instanceof HTMLElement) {
      curtain.style.opacity = "0";
      curtain.style.visibility = "hidden";
      curtain.style.pointerEvents = "none";
    }
  };

  const onReady = (callback) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
    } else {
      callback();
    }
  };

  const getPreset = (mode) => {
    switch (mode) {
      case "slide-left":
        return { from: { autoAlpha: 0, x: 40 }, start: "top 85%", duration: 0.9, ease: "power2.out" };
      case "slide-right":
        return { from: { autoAlpha: 0, x: -40 }, start: "top 85%", duration: 0.9, ease: "power2.out" };
      case "zoom-in":
        return { from: { autoAlpha: 0, scale: 0.94 }, start: "top 85%", duration: 1.0, ease: "power2.out" };
      case "rise-blur":
        return { from: { autoAlpha: 0, y: 28, filter: "blur(6px)" }, start: "top 85%", duration: 1.05, ease: "power2.out" };
      case "clip-up":
        return { from: { autoAlpha: 0, y: 18, clipPath: "inset(0 0 100% 0)" }, start: "top 85%", duration: 1.05, ease: "power2.out" };
      case "rotate-in":
        return {
          from: { autoAlpha: 0, y: 16, rotation: -2, transformOrigin: "left bottom" },
          start: "top 85%",
          duration: 1.0,
          ease: "power2.out"
        };
      case "text-reveal":
        return { from: { autoAlpha: 0, y: 20 }, start: "top 86%", duration: 0.8, ease: "power2.out" };
      case "fade-quick":
        return { from: { autoAlpha: 0, y: 30 }, start: "top 93%", duration: 1.35, ease: "power2.out" };
      default:
        return { from: { autoAlpha: 0, y: 20 }, start: "top 85%", duration: 0.95, ease: "power2.out" };
    }
  };

  const animateElement = (element) => {
    const mode = element.getAttribute("data-animate") ?? "fade-up";
    const preset = getPreset(mode);
    const usesClipPath = mode === "clip-up";

    gsap.fromTo(
      element,
      {
        ...preset.from,
        force3D: true
      },
      {
        autoAlpha: 1,
        x: 0,
        y: 0,
        scale: 1,
        rotation: 0,
        letterSpacing: "normal",
        filter: "blur(0px)",
        ...(usesClipPath ? { clipPath: "inset(0 0 0% 0)" } : {}),
        duration: preset.duration,
        ease: preset.ease,
        immediateRender: false,
        overwrite: "auto",
        clearProps: usesClipPath ? "clipPath,willChange" : "willChange",
        scrollTrigger: {
          trigger: element,
          start: preset.start,
          once: true,
          invalidateOnRefresh: true
        }
      }
    );
  };

  const animateStaggerChildren = () => {
    document.querySelectorAll("[data-stagger]").forEach((group) => {
      const children = Array.from(group.children).filter((child) => !child.hasAttribute("data-animate"));
      if (!children.length) return;

      children.forEach((child, index) => {
        gsap.fromTo(
          child,
          { autoAlpha: 0, y: 20, scale: 0.985, force3D: true },
          {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            duration: 1.05,
            delay: index * 0.05,
            ease: "power2.out",
            immediateRender: false,
            overwrite: "auto",
            clearProps: "willChange",
            scrollTrigger: {
              trigger: child,
              start: "top 85%",
              once: true,
              invalidateOnRefresh: true
            }
          }
        );
      });
    });
  };

  const animateParallax = () => {
    document.querySelectorAll(".parallax-image").forEach((image) => {
      gsap.to(image, {
        yPercent: 8,
        scale: 1.05,
        ease: "none",
        force3D: true,
        scrollTrigger: {
          trigger: image,
          start: "top bottom",
          end: "bottom top",
          scrub: 0.8,
          invalidateOnRefresh: true
        }
      });
    });
  };

  const animateFloatingDecor = () => {
    document.querySelectorAll("[data-float]").forEach((shape) => {
      const speed = shape.getAttribute("data-float") === "fast" ? 14 : 22;
      gsap.to(shape, {
        y: -14,
        x: 8,
        rotate: 4,
        repeat: -1,
        yoyo: true,
        duration: speed,
        ease: "sine.inOut"
      });
    });
  };

  const handleNavTap = () => {
    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href") ?? "";
        const hash = href.startsWith("#") ? href : href.startsWith("/#") ? href.slice(1) : "";
        if (!hash) return;
        const target = document.querySelector(hash);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  };

  const initAnimations = () => {
    gsap.killTweensOf("[data-animate], [data-stagger] > *, .parallax-image, [data-float]");
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

    document.querySelectorAll("[data-animate]").forEach((element) => {
      animateElement(element);
    });

    animateStaggerChildren();
    animateParallax();
    animateFloatingDecor();
    ScrollTrigger.refresh();
  };

  const runOpening = () => {
    if (!(curtain instanceof HTMLElement) || !(root instanceof HTMLElement)) {
      initAnimations();
      return;
    }

    root.style.opacity = "1";
    initAnimations();

    gsap
      .timeline()
      .to(curtain, {
        opacity: 0,
        duration: 0.45,
        ease: "power2.out"
      })
      .to(
        root,
        {
          opacity: 1,
          duration: 0.35,
          ease: "power2.out",
          onComplete: () => {
            curtain.remove();
          }
        },
        "-=0.2"
      );
  };

  onReady(() => {
    handleNavTap();
    runOpening();

    window.addEventListener(
      "load",
      () => {
        ScrollTrigger.refresh();
      },
      { once: true }
    );

    if (document.fonts?.ready) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }

    window.addEventListener("gallery:image-load", () => {
      ScrollTrigger.refresh();
    });
  });

  window.setTimeout(() => {
    if (curtain instanceof HTMLElement && curtain.style.opacity !== "0") {
      revealFallback();
      if (!ScrollTrigger.getAll().length) {
        initAnimations();
      }
    }
  }, 1400);
</script>
