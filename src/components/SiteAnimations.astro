<script type="module">
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const curtain = document.querySelector("#opening-curtain");
  const root = document.querySelector("#site-root");

  const revealFallback = () => {
    if (root instanceof HTMLElement) root.style.opacity = "1";
    if (curtain instanceof HTMLElement) {
      curtain.style.opacity = "0";
      curtain.style.visibility = "hidden";
      curtain.style.pointerEvents = "none";
    }
  };

  const onReady = (callback) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
    } else {
      callback();
    }
  };

  const runOpening = () => {
    if (!curtain || !root) return;
    root.style.opacity = "1";

    gsap
      .timeline()
      .to(curtain, {
        opacity: 0,
        duration: 1.1,
        ease: "power2.out"
      })
      .to(
        root,
        {
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
          onComplete: () => curtain.remove()
        },
        "-=0.45"
      );
  };

  const animateByMode = (element, mode) => {
    const base = { duration: 1.02, ease: "power3.out", opacity: 0 };
    const fromConfig =
      mode === "slide-left"
        ? { ...base, x: 72 }
        : mode === "slide-right"
          ? { ...base, x: -72 }
          : mode === "zoom-in"
            ? { ...base, scale: 0.86 }
            : mode === "rise-blur"
              ? { ...base, y: 56, filter: "blur(14px)" }
              : mode === "clip-up"
                ? { ...base, y: 32, clipPath: "inset(0 0 100% 0)" }
                : mode === "rotate-in"
                  ? { ...base, y: 28, rotation: -4, transformOrigin: "left bottom" }
                  : mode === "text-reveal"
                    ? { ...base, y: 44, letterSpacing: "0.32em" }
                    : { ...base, y: 30 };

    gsap.from(element, {
      ...fromConfig,
      scrollTrigger: {
        trigger: element,
        start: "top 84%",
        end: "bottom 20%",
        toggleActions: "play none none reverse"
      }
    });
  };

  const animateSections = () => {
    document.querySelectorAll("[data-animate]").forEach((element) => {
      const mode = element.getAttribute("data-animate") ?? "fade-up";
      animateByMode(element, mode);
    });

    document.querySelectorAll("[data-stagger]").forEach((group) => {
      const children = Array.from(group.children);
      if (!children.length) return;

      gsap.from(children, {
        opacity: 0,
        y: 36,
        scale: 0.97,
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.13,
        scrollTrigger: {
          trigger: group,
          start: "top 82%",
          end: "bottom 20%",
          toggleActions: "play none none reverse"
        }
      });
    });

    document.querySelectorAll(".parallax-image").forEach((image) => {
      gsap.to(image, {
        yPercent: 10,
        scale: 1.07,
        ease: "none",
        scrollTrigger: {
          trigger: image,
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });
    });

    document.querySelectorAll("[data-float]").forEach((shape) => {
      const speed = shape.getAttribute("data-float") === "fast" ? 14 : 24;
      gsap.to(shape, {
        y: -28,
        x: 20,
        rotate: 10,
        repeat: -1,
        yoyo: true,
        duration: speed,
        ease: "sine.inOut"
      });

      gsap.to(shape, {
        yPercent: 24,
        ease: "none",
        scrollTrigger: {
          trigger: shape.closest("section"),
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });
    });

    document.querySelectorAll(".section-frame").forEach((section) => {
      const decor = section.querySelector(".section-decor");
      if (!decor) return;

      gsap.fromTo(
        decor,
        { opacity: 0.35 },
        {
          opacity: 1,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top 90%",
            end: "bottom 10%",
            scrub: true
          }
        }
      );
    });
  };

  const handleNavTap = () => {
    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");
        if (!href || !href.startsWith("#")) return;
        const target = document.querySelector(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  };

  onReady(() => {
    handleNavTap();
    runOpening();
    animateSections();
  });

  window.setTimeout(() => {
    if (curtain instanceof HTMLElement && curtain.style.opacity !== "0") revealFallback();
  }, 2400);
</script>
