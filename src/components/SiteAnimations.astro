<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  document.documentElement.classList.add("js-gsap");

  const curtain = document.querySelector("#opening-curtain");
  const root = document.querySelector("#site-root");

  const revealFallback = () => {
    if (root instanceof HTMLElement) root.style.opacity = "1";
    if (curtain instanceof HTMLElement) {
      curtain.style.opacity = "0";
      curtain.style.visibility = "hidden";
      curtain.style.pointerEvents = "none";
    }
  };

  const onReady = (callback) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
    } else {
      callback();
    }
  };

  const animateByMode = (element, mode) => {
    const base = { autoAlpha: 0, force3D: true };
    const fromConfig =
      mode === "slide-left"
        ? { ...base, x: 40 }
        : mode === "slide-right"
          ? { ...base, x: -40 }
          : mode === "zoom-in"
            ? { ...base, scale: 0.94 }
            : mode === "rise-blur"
              ? { ...base, y: 26, filter: "blur(6px)" }
              : mode === "clip-up"
                ? { ...base, y: 18, clipPath: "inset(0 0 100% 0)" }
                : mode === "rotate-in"
                  ? { ...base, y: 16, rotation: -2, transformOrigin: "left bottom" }
                  : mode === "text-reveal"
                    ? { ...base, y: 20 }
                    : { ...base, y: 20 };

    gsap.set(element, fromConfig);

    gsap.to(
      element,
      {
        autoAlpha: 1,
        x: 0,
        y: 0,
        scale: 1,
        rotation: 0,
        letterSpacing: "normal",
        filter: "blur(0px)",
        clipPath: "inset(0 0 0% 0)",
        duration: 1.05,
        ease: "power3.out",
        overwrite: "auto",
        clearProps: "willChange",
        scrollTrigger: {
          trigger: element,
          start: "top 88%",
          once: true
        }
      }
    );
  };

  const animateSections = () => {
    document.querySelectorAll("[data-animate]").forEach((element) => {
      const mode = element.getAttribute("data-animate") ?? "fade-up";
      animateByMode(element, mode);
    });

    document.querySelectorAll("[data-stagger]").forEach((group) => {
      const children = Array.from(group.children).filter((child) => !child.hasAttribute("data-animate"));
      if (!children.length) return;

      gsap.set(children, { autoAlpha: 0, y: 20, scale: 0.985, force3D: true });
      gsap.to(children, {
        autoAlpha: 1,
        y: 0,
        scale: 1,
        duration: 0.95,
        ease: "power3.out",
        stagger: 0.12,
        overwrite: "auto",
        clearProps: "willChange",
        scrollTrigger: {
          trigger: group,
          start: "top 88%",
          once: true
        }
      });
    });

    document.querySelectorAll(".parallax-image").forEach((image) => {
      gsap.to(image, {
        yPercent: 8,
        scale: 1.05,
        ease: "none",
        force3D: true,
        scrollTrigger: {
          trigger: image,
          start: "top bottom",
          end: "bottom top",
          scrub: 0.8
        }
      });
    });

    document.querySelectorAll("[data-float]").forEach((shape) => {
      const speed = shape.getAttribute("data-float") === "fast" ? 14 : 22;
      gsap.to(shape, {
        y: -14,
        x: 8,
        rotate: 4,
        repeat: -1,
        yoyo: true,
        duration: speed,
        ease: "sine.inOut"
      });
    });
  };

  const handleNavTap = () => {
    document.querySelectorAll(".nav-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");
        if (!href || !href.startsWith("#")) return;
        const target = document.querySelector(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  };

  const initAnimations = () => {
    gsap.killTweensOf("[data-animate], [data-stagger] > *, .parallax-image, [data-float]");
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    animateSections();
    ScrollTrigger.refresh();
  };

  const runOpening = () => {
    if (!curtain || !root) {
      initAnimations();
      return;
    }
    root.style.opacity = "1";

    gsap
      .timeline()
      .to(curtain, {
        opacity: 0,
        duration: 1.1,
        ease: "power2.out"
      })
      .to(
        root,
        {
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
          onComplete: () => {
            curtain.remove();
            initAnimations();
          }
        },
        "-=0.45"
      );
  };

  onReady(() => {
    handleNavTap();
    runOpening();
  });

  window.setTimeout(() => {
    if (curtain instanceof HTMLElement && curtain.style.opacity !== "0") {
      revealFallback();
      initAnimations();
    }
  }, 2400);
</script>
